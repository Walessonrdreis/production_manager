model ProductionOrderReadModel {
  id String @id @default(cuid())

  // ─── Identificação ────────────────────────────────────────────────
  omieId         String  @unique @db.VarChar(64) @map("omie_id")
  orderNumber    String? @db.VarChar(32) @map("order_number")
  productCode    String? @db.VarChar(64) @map("product_code")
  productOmieId  String? @db.VarChar(64) @map("product_omie_id")
  productName    String? @db.Text @map("product_name")
  productUnit    String? @db.VarChar(16) @map("product_unit")

  // ─── UX / Busca (normalized fields) ───────────────────────────────
  productNameNormalized  String? @db.Text        @map("product_name_normalized")
  productCodeNormalized  String? @db.VarChar(64) @map("product_code_normalized")
  orderNumberNormalized  String? @db.VarChar(32) @map("order_number_normalized")
  normalizeVersion       Int     @default(0)     @map("normalize_version")

  // ─── Stage (UX) ────────────────────────────────────────────────────
  stageName  String? @db.VarChar(32) @map("stage_name")
  stageOrder Int     @default(999)   @map("stage_order")
  stageGroup String  @default("unknown") @db.VarChar(16) @map("stage_group")

  // ─── Quantidades ──────────────────────────────────────────────────
  quantity Decimal @db.Decimal(18, 4)

  // ─── Estágio / Status ─────────────────────────────────────────────
  stage             String? @db.VarChar(10)
  operationalStatus String  @default("pending") @db.VarChar(20) @map("operational_status")

  // ─── Flags calculadas ─────────────────────────────────────────────
  isOpen               Boolean @default(true)  @map("is_open")
  isLate               Boolean @default(false) @map("is_late")
  isReady              Boolean @default(false) @map("is_ready")
  isBlocked            Boolean @default(false) @map("is_blocked")
  hasStockIssue        Boolean @default(false) @map("has_stock_issue")
  hasMissingMaterials  Boolean @default(false) @map("has_missing_materials")
  hasCriticalMaterial  Boolean @default(false) @map("has_critical_material")
  hasPartialStock      Boolean @default(false) @map("has_partial_stock")
  hasStructure         Boolean @default(false) @map("has_structure")

  // ─── Prioridade ───────────────────────────────────────────────────
  priority String @default("low") @db.VarChar(10)

  // ─── Datas ────────────────────────────────────────────────────────
  expectedAt  DateTime? @map("expected_at")
  startedAt   DateTime? @map("started_at")
  completedAt DateTime? @map("completed_at")
  daysOverdue Int @default(0) @map("days_overdue")

  // ─── JSONs ────────────────────────────────────────────────────────
  materialsJson        Json? @map("materials_json")
  materialsSummaryJson Json? @map("materials_summary_json")
  readinessJson        Json? @map("readiness_json")
  alertsJson           Json? @map("alerts_json")

  // ─── Metadados ────────────────────────────────────────────────────
  lastSyncAt DateTime? @map("last_sync_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt      @map("updated_at")

  @@index([isOpen])
  @@index([isReady])
  @@index([isBlocked])
  @@index([operationalStatus])
  @@index([priority])
  @@index([expectedAt])
  @@index([isLate])

  // ─── Índices de busca — spec search UX (C0) ───────────────────────
  @@index([productName], map: "idx_prorm_product_name")
  @@index([productCode], map: "idx_prorm_product_code")
  @@index([orderNumber], map: "idx_prorm_order_number")

  // ─── Índices de performance — spec v2 (C0)
  //       Mantidos no schema para evitar que o Prisma os drope — REGRA 7
  @@index([materialsJson], type: Gin, map: "idx_prorm_materials_gin")
  @@index([isOpen, priority(sort: Desc), expectedAt], map: "idx_prorm_open_priority_expected")
  @@index([isOpen, expectedAt], map: "idx_prorm_open_expected")
  @@index([isOpen, stage], map: "idx_prorm_open_stage")
  @@index([hasStockIssue], map: "idx_prorm_has_stock_issue")
  @@index([hasMissingMaterials], map: "idx_prorm_has_missing_materials")
  @@index([hasCriticalMaterial], map: "idx_prorm_has_critical_material")

  @@map("production_order_read_model")
  @@schema("read_model")
}


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SyncLock {
  key         String   @id
  lockedUntil DateTime
}

model JobLock {
  key         String   @id @db.VarChar(64)
  lockedUntil DateTime
  updatedAt   DateTime @updatedAt

  @@map("job_lock")
}

model OmieProduct {
  id                String   @id @default(uuid())
  omieCode          String   @db.VarChar(64)
  omieId            String?  @db.VarChar(64)
  sku               String?  @db.VarChar(128)
  description       String   @db.Text
  familyDescription String?  @db.Text
  active            Boolean  @default(true)
  rawPayload        Json
  lastSyncAt        DateTime @default(now())

  product Product?

  @@unique([omieCode])
  @@index([description])
}

model Product {
  id            String      @id @default(uuid())
  omieProductId String      @unique
  omieProduct   OmieProduct @relation(fields: [omieProductId], references: [id], onDelete: Cascade)
  nickname      String?
  active        Boolean     @default(true)

  productSector ProductSector?
  planItems     ProductionPlanItem[]
}

model Sector {
  id     String  @id @default(uuid())
  name   String  @unique
  order  Int     @default(0)
  active Boolean @default(true)

  productSectors ProductSector[]
  planItems      ProductionPlanItem[]
}

model ProductSector {
  productId String  @id
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sectorId  String
  sector    Sector  @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  notes     String?
}

enum PlanStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

model ProductionPlan {
  id        String     @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    PlanStatus @default(DRAFT)
  createdAt DateTime   @default(now())

  items ProductionPlanItem[]

  @@index([startDate, endDate])
}

model ProductionPlanItem {
  id        String         @id @default(uuid())
  planId    String
  plan      ProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  productId String
  product   Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  sectorId  String
  sector    Sector         @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  quantity  Int
  notes     String?

  @@index([planId, sectorId])
  @@index([productId])
}

model ProductStock {
  id            String   @id @default(uuid()) @db.Uuid
  omieCode      String   @db.VarChar(64)
  stockQuantity Decimal  @db.Decimal(18, 4)
  minimumStock  Decimal  @db.Decimal(18, 4)
  updatedAt     DateTime @updatedAt
  capturedAt    DateTime @default(now())

  @@unique([omieCode])
  @@map("product_stock")
}

model OmieOrder {
  id           String  @id @default(uuid())

/// cabecalho.codigo_pedido
omieCode     String  @db.VarChar(64)

/// cabecalho.numero_pedido (ex: "1305")
numeroPedido String? @db.VarChar(64)


  /// cabecalho.codigo_cliente
  codigoCliente String?  @db.VarChar(64)

  codigoEmpresa String?  @db.VarChar(64)
  etapa         String   @db.VarChar(10)

  cancelado     String   @default("N") @db.Char(1)
  encerrado     String   @default("N") @db.Char(1)

  dataPrevisao  DateTime?

  rawPayload    Json
  lastSyncAt    DateTime @default(now())

  items         OmieOrderItem[]

  @@unique([omieCode])
  @@index([etapa])
  @@index([cancelado, encerrado])
  @@index([codigoCliente])
  @@map("omie_order")
}



model OmieOrderItem {
  id           String   @id @default(uuid())

  /// ide.codigo_item
  omieItemCode String   @db.VarChar(64)

  /// relação com pedido
  omieOrderId  String
  order        OmieOrder @relation(fields: [omieOrderId], references: [id], onDelete: Cascade)

  /// produto.codigo_produto / produto.codigo (SKU)
  omieProductCode String? @db.VarChar(64)
  sku             String? @db.VarChar(128)

  /// produto.descricao
  description     String  @db.Text

  /// produto.unidade
  unit            String? @db.VarChar(16)

  /// produto.quantidade (vem como número; guardamos Decimal)
  quantity        Decimal @db.Decimal(18, 4)

  /// opcionais úteis
  unitPrice       Decimal? @db.Decimal(18, 6)
  totalPrice      Decimal? @db.Decimal(18, 2)

  rawPayload      Json
  lastSyncAt      DateTime @default(now())

  @@unique([omieItemCode])
  @@index([omieOrderId])
  @@index([omieProductCode])
  @@index([description])
  @@map("omie_order_item")
}
model Client {
  id String @id @default(uuid())

  omieClientCode BigInt @unique @map("codigo_cliente_omie")

  legalName  String  @map("razao_social")
  tradeName  String? @map("nome_fantasia")
  document   String  @map("documento")

  personType PersonType @map("tipo_pessoa")

  email String?
  phone String? @map("telefone")

  isActive         Boolean @default(true)
  isBlocked        Boolean @default(false)
  isBillingBlocked Boolean @default(false)

  createdAtOmie DateTime?
  updatedAtOmie DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relacionamento lógico apenas (sem FK)
  // orders OmieOrder[]

  @@map("clientes")
}

model OmieProductionOrder {
  id           String  @id @default(uuid())

  /// identificacao.nCodOP
  omieCode     String  @db.VarChar(64)

  /// identificacao.cCodIntOP
  internalCode String? @db.VarChar(64)

  /// identificacao.nCodProduto
  productCode  String? @db.VarChar(64)

  /// identificacao.cCodIntProd
  productIntegrationCode String? @db.VarChar(128)

  /// identificacao.nQtde
  quantity     String  @db.VarChar(32)

  /// identificacao.dDtPrevisao
  forecastDate DateTime?

  /// infAdicionais.dDtInicio
  startDate    DateTime?

  /// infAdicionais.dDtConclusao
  completionDate DateTime?

  /// infAdicionais.cEtapa
  stage        String? @db.VarChar(10)

  /// infAdicionais.nCodProjeto
  projectCode  String? @db.VarChar(64)

  /// outrasInf.cConcluida
  completed    Boolean @default(false)

  /// Flag para controle de reconciliação
  active       Boolean @default(true)

  rawPayload   Json
  lastSyncAt   DateTime @default(now())

  items        OmieProductionOrderItem[]

  @@unique([omieCode])
  @@index([productCode])
  @@index([productIntegrationCode])
  @@index([completed])
  @@index([forecastDate])
  @@index([completionDate])
  @@map("omie_production_order")
}

model OmieProductionOrderItem {
  id           String   @id @default(uuid())

  /// Código único do item (gerado internamente)
  omieItemCode String   @db.VarChar(128)

  /// relação com ordem de produção
  omieProductionOrderId  String
  productionOrder        OmieProductionOrder @relation(fields: [omieProductionOrderId], references: [id], onDelete: Cascade)

  /// nIdProdutoMalha
  productMeshId BigInt?

  /// cUtilizarDoEstoque
  useFromStock  String? @db.Char(1)

  /// nQtde (itensDetalhes)
  quantity      String? @db.VarChar(32)

  /// codigo_local_estoque
  stockLocationCode BigInt?

  /// cObs
  observation   String? @db.Text

  rawPayload    Json
  lastSyncAt    DateTime @default(now())

  @@unique([omieItemCode])
  @@index([omieProductionOrderId])
  @@index([productMeshId])
  @@map("omie_production_order_item")
}

model SyncRecord {
  id            String   @id @default(uuid())
  syncType      String   @db.VarChar(32)
  status        String   @db.VarChar(32)
  startedAt     DateTime
  completedAt   DateTime?
  durationMs    Int?
  itemsProcessed Int     @default(0)
  itemsFailed   Int      @default(0)
  error         String?  @db.Text
  metadata      Json?

  @@index([syncType])
  @@index([status])
  @@index([startedAt])
  @@map("sync_record")
}

model StockAlert {
  id                 String   @id @default(uuid())
  productCode        String   @db.VarChar(64)
  productDescription String   @db.Text
  currentStock       Decimal  @db.Decimal(18, 4)
  minimumStock       Decimal  @db.Decimal(18, 4)
  severity           String   @db.VarChar(16)
  status             String   @db.VarChar(16)
  createdAt          DateTime @default(now())
  resolvedAt         DateTime?
  metadata           Json?

  @@index([productCode])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
  @@map("stock_alert")
}

model AlertConfig {
  id                   String   @id @default(uuid())
  productCode          String?  @db.VarChar(64)
  criticalThreshold    Decimal  @db.Decimal(18, 4)
  warningThreshold     Decimal  @db.Decimal(18, 4)
  notificationChannels String[] // Array de strings para canais
  autoResolveDays      Int      @default(7)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([productCode])
  @@index([productCode])
  @@map("alert_config")
}

enum PersonType {
  INDIVIDUAL @map("FISICA")
  COMPANY    @map("JURIDICA")

  // Se o tipo enum no Postgres já se chama "TipoPessoa", mantenha:
  @@map("TipoPessoa")
}

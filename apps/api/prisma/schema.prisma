model ProductCatalogProductionReadyReadModel {
  id String @id @default(cuid())

  productCode String @unique @db.VarChar(64) @map("product_code")
  productOmieId String? @db.VarChar(64) @map("product_omie_id")
  omieCode String? @db.VarChar(64) @map("omie_code")

  description String @db.Text
  sku String? @db.VarChar(128)

  active Boolean @default(true)

  family String? @db.Text
  unit String? @db.VarChar(16)

  salePrice Decimal? @db.Decimal(18, 6) @map("sale_price")
  cost Decimal? @db.Decimal(18, 6)
  margin Decimal? @db.Decimal(18, 6)

  stock Decimal @default(0) @db.Decimal(18, 4)
  minimumStock Decimal @default(0) @db.Decimal(18, 4) @map("minimum_stock")

  available Boolean @default(false) @map("available")
  belowMinimumStock Boolean @default(false) @map("below_minimum_stock")

  hasStructure Boolean @default(false) @map("has_structure")
  structureItemsCount Int @default(0) @map("structure_items_count")
  structureItemsBelowMinStock Int @default(0) @map("structure_items_below_min_stock")

  hasOpenProductionOrder Boolean @default(false) @map("has_open_production_order")
  openProductionOrderCount Int @default(0) @map("open_production_order_count")

  hasOpenSalesOrderStage20 Boolean @default(false) @map("has_open_sales_order_stage20")
  openSalesOrderStage20Count Int @default(0) @map("open_sales_order_stage20_count")

  lastSyncAt DateTime? @map("last_sync_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([active])
  @@index([available])
  @@index([belowMinimumStock])
  @@index([hasStructure])
  @@index([hasOpenProductionOrder])
  @@index([hasOpenSalesOrderStage20])
  @@index([description])
  @@index([stock])
  @@index([updatedAt])

  @@map("product_catalog_production_ready_read_model")
  @@schema("read_model")
}


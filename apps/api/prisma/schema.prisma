  omieId                  String   @unique @db.VarChar(64)    @map("omie_id")
  orderNumber             String?  @db.VarChar(64)            @map("order_number")
  stage                   String   @db.VarChar(10)
  isCanceled              Boolean  @default(false)            @map("is_canceled")
  isClosed                Boolean  @default(false)            @map("is_closed")
  customerOmieId          String?  @db.VarChar(64)            @map("customer_omie_id")
  companyOmieId           String?  @db.VarChar(64)            @map("company_omie_id")
  customerName            String?  @db.Text                   @map("customer_name")
  forecastDate            DateTime?                           @map("forecast_date")
  totalAmount             Decimal? @db.Decimal(18, 2)         @map("total_amount")
  totalItems              Int      @default(0)                @map("total_items")
  totalQuantity           Decimal  @default(0) @db.Decimal(18, 4) @map("total_quantity")
  lastSyncAt              DateTime?                           @map("last_sync_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([stage])
  @@index([isCanceled])
  @@index([isClosed])
  @@index([customerOmieId])

  @@map("sales_order_summary_read_model")
  @@schema("read_model")

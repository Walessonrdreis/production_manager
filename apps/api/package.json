{
  "name": "@production-manager/api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "pnpm run db:migrate:prod && node dist/server.js",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "vitest run",
    "backfill:omie-code": "tsx scripts/backfill-omie-code.ts",
    "metrics:all": "node scripts/metrics/all.mjs",
    "metrics:tree": "node scripts/metrics/tree.mjs src 4",
    "metrics:loc": "node scripts/metrics/loc.mjs",
    "metrics:sizes": "node scripts/metrics/sizes.mjs",
    "metrics:endpoints": "node scripts/metrics/endpoints.mjs",
    "metrics:drift": "node scripts/metrics/endpoints-drift.mjs",
    "metrics:prisma": "node scripts/metrics/prisma-schema.mjs",
    "metrics:migrations": "node scripts/metrics/migrations.mjs",
    "metrics:env": "node scripts/metrics/env-check.mjs",
    "metrics:exports": "node scripts/metrics/exports.mjs",
    "metrics:readme": "node scripts/metrics/render-readme.mjs",
    "docs:contract": "node scripts/metrics/render-api-contract.mjs",
    "docs:status": "node scripts/metrics/render-md.mjs",
    "docs:reference": "node scripts/metrics/render-reference.mjs",
    "docs:typedoc": "typedoc",
    "docs:status:history": "node scripts/metrics/render-md.mjs --history",
    "metrics:update-docs": "pnpm metrics:all && pnpm docs:status"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@prisma/client": "^5.12.0",
    "@shared/contracts": "workspace:*",
    "dotenv": "^17.4.1",
    "fastify": "^4.26.2",
    "node-cron": "^4.2.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "prisma": "^5.12.0",
    "tsx": "^4.7.2",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}

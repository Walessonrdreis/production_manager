{
  "name": "@production-manager/api",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "tsx -r tsconfig-paths/register src/server.ts",
    "build": "tsup",
    "start": "pnpm run db:migrate:resilient && node dist/server.js",
    "prisma:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:migrate:resilient": "node scripts/resilient-migrate.js",
    "db:migrate:local": "node scripts/migrate-local.js",
    "db:studio": "prisma studio",
    "db:studio:local": "cross-env DATABASE_URL=postgresql://postgres:postgres@localhost:5432/production_manager?schema=public prisma studio",
    "test": "vitest run",
    "seed:sales-order-transitions": "tsx scripts/seed-sales-order-transitions.ts",
    "backfill:omie-code": "tsx scripts/backfill-omie-code.ts",
    "trello:register-webhook": "tsx scripts/trello/register-webhook.ts",
    "metrics:all": "node scripts/metrics/all.mjs",
    "metrics:tree": "node scripts/metrics/tree.mjs src 4",
    "metrics:loc": "node scripts/metrics/loc.mjs",
    "metrics:sizes": "node scripts/metrics/sizes.mjs",
    "metrics:endpoints": "node scripts/metrics/endpoints.mjs",
    "metrics:drift": "node scripts/metrics/endpoints-drift.mjs",
    "metrics:prisma": "node scripts/metrics/prisma-schema.mjs",
    "metrics:migrations": "node scripts/metrics/migrations.mjs",
    "metrics:env": "node scripts/metrics/env-check.mjs",
    "metrics:exports": "node scripts/metrics/exports.mjs",
    "metrics:readme": "node scripts/metrics/render-readme.mjs",
    "docs:contract": "node scripts/metrics/render-api-contract.mjs",
    "docs:status": "node scripts/metrics/render-md.mjs",
    "docs:reference": "node scripts/metrics/render-reference.mjs",
    "docs:typedoc": "typedoc",
    "docs:status:history": "node scripts/metrics/render-md.mjs --history",
    "metrics:update-docs": "pnpm metrics:all && pnpm docs:status",
    "gen:module": "ts-node scripts/scaffold/index.ts",
    "gen:structure": "ts-node scripts/update-estrutura-projeto.mjs",
    "gen:resumo": "ts-node scripts/update-resumo-projeto.mjs",
    "generate:module": "pnpm run gen:module",
    "docs:estrutura": "node scripts/update-estrutura-projeto-dirs-summary.js",
    "create:file": "ts-node scripts/create-file-interactive.ts",
    "db:fix:failed": "node scripts/fix-failed-migration.js"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.6",
    "@prisma/client": "5.22.0",
    "@shared/contracts": "workspace:*",
    "dotenv": "^17.4.1",
    "fastify": "^4.26.2",
    "node-cron": "^4.2.1",
    "pg-boss": "^12.20.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/swagger-ui-express": "^4.1.8",
    "cross-env": "^7.0.3",
    "prisma": "5.22.0",
    "tsconfig-paths": "^4.2.0",
    "tsup": "^8.5.1",
    "tsx": "^4.7.2",
    "typedoc": "^0.28.19",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
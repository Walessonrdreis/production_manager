      registros_por_pagina: 50,
          },
        ],
      }
    );

    return response.clientes ?? response.clientes_cadastro ?? [];
  }

  async getClientByCode(omieClientCode: bigint): Promise<OmieClientRaw | null> {
    const codeAsNumber = Number(omieClientCode);

    // tentativa 1: codigo_cliente_omie
    try {
      const resp1 = await this.omieClient.post<OmieConsultarClienteResponse>(
        "/api/v1/geral/clientes/",
        {
          call: "ConsultarCliente",
          param: [{ codigo_cliente_omie: codeAsNumber }],
        }
      );

      if (resp1?.faultstring || resp1?.error) return null;
      if (resp1?.razao_social || resp1?.cnpj_cpf || resp1?.codigo_cliente_omie) return resp1;
    } catch {
      // segue
    }

    // tentativa 2: codigo_cliente
    try {
      const resp2 = await this.omieClient.post<OmieConsultarClienteResponse>(
        "/api/v1/geral/clientes/",
        {
          call: "ConsultarCliente",
          param: [{ codigo_cliente: codeAsNumber }],
        }
      );

      if (resp2?.faultstring || resp2?.error) return null;
      if (resp2?.razao_social || resp2?.cnpj_cpf || resp2?.codigo_cliente_omie) return resp2;

      return null;
    } catch {
      return null;
    }
  }
